    {
      "id": "_agents_skills_supabase_skill_data_api_exposure",
      "label": "Data API Table Exposure",
      "file_type": "concept",
      "source_file": "C:\\Users\\Administrator\\minzotechintv\\Group-1_Minzo_Tech_Interview\\.agents\\skills\\supabase\\SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Newly created SQL tables may not be automatically accessible through PostgREST Data API without explicit GRANT SQL to anon and authenticated roles."
    },
    {
      "id": "_agents_skills_supabase_skill_rls_security_rules",
      "label": "Row Level Security Rules",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Administrator\\minzotechintv\\Group-1_Minzo_Tech_Interview\\.agents\\skills\\supabase\\SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Enforce RLS in all exposed schemas. auth.role() is deprecated in favor of TO role; ownership predicate is mandatory to prevent BOLA; UPDATE requires both USING and WITH CHECK."
    },
    {
      "id": "_agents_skills_supabase_skill_auth_and_session_security",
      "label": "Auth and Session Security Policy",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Administrator\\minzotechintv\\Group-1_Minzo_Tech_Interview\\.agents\\skills\\supabase\\SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "raw_user_meta_data is client-editable and unsafe for authorization in RLS; raw_app_meta_data must be used instead, and session revocations must be validated."
    },
    {
      "id": "_agents_skills_supabase_skill_scoped_access_tokens",
      "label": "Scoped Personal Access Tokens Policy",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Administrator\\minzotechintv\\Group-1_Minzo_Tech_Interview\\.agents\\skills\\supabase\\SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Never use classic full-account PATs in scripts, CI, or agents; scoped tokens limited to targeted organizations and projects should be used instead."
    },
    {
      "id": "_agents_skills_supabase_skill_security_definer_guidance",
      "label": "Security Definer Functions Guidance",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Administrator\\minzotechintv\\Group-1_Minzo_Tech_Interview\\.agents\\skills\\supabase\\SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "SECURITY DEFINER bypasses RLS and is callable by PUBLIC by default; prefer SECURITY INVOKER or isolate function in a non-exposed schema with auth.uid() checks."
    },
    {
      "id": "_agents_skills_supabase_skill_cli_workflow",
      "label": "Supabase CLI Best Practices",
